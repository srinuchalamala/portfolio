rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify admin status
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email.lower() == 'srinu@gmail.com';
    }

    // Public portfolio collections:
    // Anyone can read public portfolio content; only verified admin can create/update/delete.
    match /profiles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /certifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /experience/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /organizations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /interests/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Messages collection:
    // Public visitors can only create (submit inquiries).
    // Only authenticated admin can read, update status, or delete messages.
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // Activity Logs collection:
    // Private audit trail - only admin can read and append.
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // Users collection:
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }
  }
}
